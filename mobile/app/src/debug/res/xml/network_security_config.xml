<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para variante "debug": habilita HTTP en texto plano únicamente para
  10.0.2.2 (localhost del host visto desde el emulador de Android) y
  127.0.0.1 (dispositivo físico por USB vía "adb reverse tcp:8081 tcp:8081"),
  donde corre el backend de desarrollo en :8081. Nunca se aplica en "release".
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
